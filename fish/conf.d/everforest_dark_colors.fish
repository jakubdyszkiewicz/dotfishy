# Everforest Dark (medium) palette for Fish.
# Loaded from conf.d at shell start.

set --global fish_color_normal d3c6aa
set --global fish_color_command a7c080 --bold
set --global fish_color_keyword d699b6
set --global fish_color_quote dbbc7f
set --global fish_color_redirection 83c092
set --global fish_color_end e69875
set --global fish_color_error e67e80 --bold
set --global fish_color_param d3c6aa
set --global fish_color_option 7fbbb3
set --global fish_color_comment 859289 --italics
set --global fish_color_selection d3c6aa --background=475258
set --global fish_color_operator e69875
set --global fish_color_escape e69875 --bold
set --global fish_color_autosuggestion 7a8478
set --global fish_color_cwd 83c092
set --global fish_color_cwd_root e67e80
set --global fish_color_user a7c080
set --global fish_color_host 7fbbb3
