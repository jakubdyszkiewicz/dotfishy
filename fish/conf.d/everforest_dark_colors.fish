set --global fish_pager_color_selected_completion d3c6aa --bold
set --global fish_pager_color_selected_description dbbc7f
set --global fish_pager_color_selected_prefix a7c080 --bold --underline

set --global --export FZF_DEFAULT_OPTS '--color=bg+:#475258,bg:#2d353b,spinner:#dbbc7f,hl:#e67e80,fg:#d3c6aa,header:#e67e80,info:#d699b6,pointer:#83c092,marker:#a7c080,fg+:#d3c6aa,prompt:#a7c080,hl+:#e67e80'
